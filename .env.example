# Variabel lingkungan Determined Studio SCM (lihat docs/PROJECT_PLAN.md §3.5)
# Salin berkas ini menjadi .env.local dan isi nilai nyata. Jangan commit .env.local.

# --- Klien dan Server (aman dipaparkan ke browser) ---
# URL utama aplikasi (lokal: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# URL proyek Supabase (mis. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon / publishable) Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server saja (JANGAN pernah diawali NEXT_PUBLIC_ atau dipakai di kode klien) ---
# Kunci service role Supabase: hanya untuk pembuatan pengguna (P3-04) dan skrip uji/bootstrap
SUPABASE_SECRET_KEY=

# Durasi sesi menganggur dalam menit sebelum keluar otomatis (default: 480)
SESSION_IDLE_MINUTES=480

# Batas percobaan masuk gagal per 15 menit (default: 8)
LOGIN_MAX_ATTEMPTS=8
